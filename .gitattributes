* text=auto eol=lf

# Shell scripts must never be CRLF, full stop — this is what boots the
# container (entrypoint.sh) and CI invokes these directly via `sh`.
*.sh text eol=lf

# Binary types — never let git touch line endings or diff these as text.
# Fonts/images matter here specifically because P-05 vendors all assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.sqlite3 binary

# Lockfiles: text, but keep LF so pip-compile --generate-hashes output
# doesn't get mangled on a Windows checkout.
requirements.txt text eol=lf
requirements*.txt text eol=lf